{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ralton-dev/.github"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard — sudoku_puzzler",
  "packageRules": [
    {
      "description": "Group related Vitest minor/patch releases together.",
      "matchPackageNames": [
        "vitest",
        "@vitest/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Vitest"
    }
  ]
}
